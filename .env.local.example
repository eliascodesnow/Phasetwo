# Supabase project settings (Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public value). Leave empty to hide the check in local development.
# Enable CAPTCHA protection in Supabase (Authentication > Attack Protection) with the matching secret key.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFI6AbFmm91TDa6-
# Web push public key (see docs/PUSH_REMINDERS.md). Optional: in-app reminders work without it.
VITE_VAPID_PUBLIC_KEY=
