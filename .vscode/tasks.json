{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PhaseTwo Vite Dev Server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"5173"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "PhaseTwo Production Build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PhaseTwo Tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"--reporter=verbose"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}